# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/robohub
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO

# Throttle scopes
THROTTLE_OTP_SEND=30/hour
THROTTLE_OTP_VERIFY=60/hour
THROTTLE_NEWSLETTER=10/hour

# Production only
# Email goes through Django's SMTP backend when EMAIL_HOST is set; without it mail is printed to the console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true, EMAIL_HOST_USER=<the gmail address>,
# EMAIL_HOST_PASSWORD=<a Google "App password" (needs 2-step verification), NOT the normal password>.
# For SSL on port 465 use EMAIL_USE_SSL=true and EMAIL_USE_TLS=false. Verify with:
#   python manage.py send_test_email you@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Stem Robo Hub <you@example.com>   # defaults to the EMAIL_HOST_USER account
# Customer emails for order events (confirmation, invoice, refund started/complete). false = send nothing.
# NOTIFICATIONS_ENABLED=true
# EMAIL_TIMEOUT=10
# Printed on invoices and emails (defaults are the storefront's business details); GSTIN only prints when set.
# SELLER_NAME=
# SELLER_ADDRESS=
# SELLER_PHONE=
# SELLER_EMAIL=
# SELLER_GSTIN=
# SECURE_SSL_REDIRECT=true

# Razorpay Payment Links (test keys from the Razorpay dashboard; never commit real values).
# Webhook: https://<your-api-host>/api/v1/payments/webhook with events payment_link.paid,
# payment_link.cancelled, payment_link.expired; put its secret in RAZORPAY_WEBHOOK_SECRET.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_LINK_EXPIRY_MINUTES=30

# Added in later phases: YOUTUBE_API_KEY, INSTAGRAM_ACCESS_TOKEN

# OTP / session (defaults shown)
# OTP_TTL_SECONDS=120
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# AUTH_TOKEN_TTL_SECONDS=604800
# Set to the number of proxies in front of the API so per-IP throttles use the real client IP
# NUM_PROXIES=1

# API docs (Swagger UI): on by default in local settings, off in production unless set
# API_DOCS_ENABLED=true

# Local only: fixed OTP for every login/registration (default 123456). Leave empty for random codes. Ignored in production.
OTP_FIXED_CODE=123456

# Session JWTs (HS256). Defaults to DJANGO_SECRET_KEY; set a separate value in production.
# JWT_SIGNING_KEY=
# JWT_ISSUER=robohub-api

# Bootstrap the first admin on hosts without a shell (read by `manage.py ensure_superuser`, run by build.sh)
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_NAME=
# DJANGO_SUPERUSER_MOBILE=
# DJANGO_SUPERUSER_PASSWORD=

# Production TESTING only: fixes every OTP to this 6-digit value (anyone can log in as any user). Remove before launch.
# INSECURE_FIXED_OTP=123456
