# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/robohub
DB_CONN_MAX_AGE=60
LOG_LEVEL=INFO

# Throttle scopes
THROTTLE_OTP_SEND=5/hour
THROTTLE_OTP_VERIFY=20/hour
THROTTLE_NEWSLETTER=10/hour

# Production only
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com
# SECURE_SSL_REDIRECT=true

# Added in later phases: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
# YOUTUBE_API_KEY, INSTAGRAM_ACCESS_TOKEN
